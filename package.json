{
  "name": "asset-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Asset Bench — browser-based tools for preparing 3D assets for games and realtime applications.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "zip:extension": "node extensions/model-optimiser/build.mjs --zip",
    "build:extension": "node extensions/model-optimiser/build.mjs",
    "zip:extension:optimiser": "node extensions/model-optimiser/build.mjs --edition model-optimiser --zip",
    "upload:extension": "node extensions/model-optimiser/make-upload-folder.mjs",
    "store-art:extension": "node extensions/model-optimiser/store/render-store-art.mjs",
    "upload:extension:edge": "node extensions/model-optimiser/make-upload-folder.mjs --edition reduce-polys-edge",
    "store-art:extension:edge": "node extensions/model-optimiser/store/render-store-art.mjs --edition reduce-polys-edge"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "wrangler": "^4.140.0"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@jsquash/webp": "^1.5.0",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.2.0",
    "three": "^0.186.0"
  }
}
