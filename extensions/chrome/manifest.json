{
  "manifest_version": 3,
  "name": "AssetBench Reduce Polys",
  "short_name": "Reduce Polys",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Cut the triangle count of any GLB model in one click, free, with the AssetBench Reduce Polys API.",
  "homepage_url": "https://www.assetbench.co.uk/docs/",
  "action": {
    "default_title": "Reduce polys",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "downloads", "sidePanel"],
  "host_permissions": ["https://www.assetbench.co.uk/*"]
}
