{
  "manifest_version": 3,
  "name": "GLB & FBX Inspector – Rig, Animation & Model Checker by AssetBench",
  "short_name": "GLB Inspector",
  "version": "1.0.7",
  "minimum_chrome_version": "116",
  "description": "Inspect GLB, FBX, OBJ and glTF models: free health check, rig and animation checks, before/after compare. Files stay local.",
  "homepage_url": "https://www.assetbench.co.uk/",
  "action": {
    "default_title": "GLB Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.lemonsqueezy.com/*",
    "https://www.assetbench.co.uk/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}