{
  "manifest_version": 3,
  "name": "GLB Texture Compressor – KTX2 & Resize by AssetBench",
  "short_name": "Texture Compressor",
  "version": "1.0.6",
  "minimum_chrome_version": "116",
  "description": "Shrink the textures in GLB models: free texture check, KTX2 compression and resizing. 10 free, then 99p. Files stay on your PC.",
  "homepage_url": "https://www.assetbench.co.uk/",
  "action": {
    "default_title": "Texture Compressor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.lemonsqueezy.com/*",
    "https://www.assetbench.co.uk/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
