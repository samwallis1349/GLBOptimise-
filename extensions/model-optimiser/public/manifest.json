{
  "manifest_version": 3,
  "name": "AssetBench Model Optimiser",
  "short_name": "Model Optimiser",
  "version": "1.0.8",
  "minimum_chrome_version": "116",
  "description": "Check, reduce, optimise and compress GLB models for games and the web, right in your browser. Files never leave your computer.",
  "homepage_url": "https://www.assetbench.co.uk/",
  "action": {
    "default_title": "Model Optimiser",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "downloads", "sidePanel"],
  "host_permissions": ["https://api.lemonsqueezy.com/*", "https://www.assetbench.co.uk/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
