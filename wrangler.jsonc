// Cloudflare Worker that serves www.assetbench.co.uk: static assets from
// ./dist, plus a tiny /api/* layer (worker/index.js) for the free-trial clock.
// Deploy with: npm run deploy
{
  "name": "glboptimise",
  "compatibility_date": "2026-09-22",
  "main": "worker/index.js",
  "routes": [
    { "pattern": "illustrator.assetbench.co.uk", "custom_domain": true },
    { "pattern": "illustration.assetbench.co.uk", "custom_domain": true },
    { "pattern": "www.assetbench.co.uk", "custom_domain": true },
    { "pattern": "assetbench.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get dist/404.html with a real 404 status (the app shell,
    // so the router shows its not-found screen). Every app route has its own
    // prerendered .html (scripts/seo-pages.mjs), so no SPA fallback is needed;
    // the old fallback answered 200 + homepage, which Google reads as soft 404s.
    "not_found_handling": "404-page",
    // Only /api/* reaches the Worker script; everything else is served
    // straight from the static assets.
    "run_worker_first": ["/api/*"]
  },
  // The Cloud API (/api/v1) encodes KTX2 textures and simplifies meshes on
  // the Worker, which needs more than the default 30 s of CPU per request.
  // Requires the Workers Paid plan; 300000 ms (5 min) is the maximum.
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "TRIAL_GENERATION": "2026-10-reset-1",
    // Cloud API billing. Lemon Squeezy product id -> plan, each product with licence keys on.
    // 1420844 is the site's All Access subscription: the API comes included.
    // 1430376 is the £50/month Studio plan (5,000 operations).
    "API_LS_PRODUCTS": { "1420844": "allaccess", "1430376": "all" },
    // Plan -> Lemon Squeezy checkout link, shown as buttons on /docs.
    "API_LS_CHECKOUTS": {
      "allaccess": "https://workbenchlabs.lemonsqueezy.com/checkout/buy/3d09253a-bc8b-44a4-853f-5882dc964807",
      "all": "https://workbenchlabs.lemonsqueezy.com/checkout/buy/c65fbf3e-dc6d-43a6-9280-1013e0c36a31"
    }
  },
  // Trial start times keyed by a salted hash of the visitor's IP.
  // Create once with: npx wrangler kv namespace create TRIALS
  // then paste the printed id below.
  "kv_namespaces": [{ "binding": "TRIALS", "id": "1bbbbc6dc36f40268430887895a49835" }],
  // Tool usage (opens + runs per tool): one Durable Object, so no count is lost (worker/index.js UsageCounter).
  "durable_objects": { "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }] },
  "migrations": [{ "tag": "v1-usage-counter", "new_sqlite_classes": ["UsageCounter"] }]
  // Optional secret salt for the IP hash: npx wrangler secret put TRIAL_SALT
}
